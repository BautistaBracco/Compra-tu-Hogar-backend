# --- Database (MySQL) ---
DB_NAME=backend
DB_USER=app
DB_PASSWORD=change_me

# For Docker Compose: host is the service name "db"
DB_URL=jdbc:mysql://db:3306/backend

# MySQL root password (used by the db container)
MYSQL_ROOT_PASSWORD=change_me_root

# --- JWT ---
# NOTE: must be at least 32 characters for HS256.
JWT_SECRET_KEY=change_me_change_me_change_me_change_me

# Milliseconds
JWT_EXPIRATION_TIME=3600000

# --- Frontend (placeholder) ---
# Example (Vite): VITE_API_BASE_URL=http://localhost:8080/api/v1
# TODO: document frontend env vars once the frontend image is defined.
